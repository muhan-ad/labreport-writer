{
  "实验": "理想气体状态方程实验",
  "groups": [
    {
      "name": "给定量",
      "fields": [
        {"key": "p0", "label": "大气压 p₀", "type": "number", "unit": "kPa", "required": true},
        {"key": "t_iso", "label": "温度 t（等温过程）", "type": "number", "unit": "℃", "required": true},
        {"key": "vp", "label": "体积视值 V′（等容过程）", "type": "number", "unit": "mL", "default": 220, "required": true}
      ]
    },
    {
      "name": "表A 等温过程（10 点）",
      "fields": [
        {"key": "ta_v", "label": "可视体积 V′", "type": "array", "length": 10, "unit": "mL", "required": true, "default": [220, 215, 210, 205, 200, 195, 190, 185, 180, 175]},
        {"key": "ta_dp", "label": "压强差 Δp", "type": "array", "length": 10, "unit": "kPa", "required": true}
      ]
    },
    {
      "name": "表B 等容过程·升温（10 点）",
      "fields": [
        {"key": "tb_t", "label": "升温 温度 t", "type": "array", "length": 10, "unit": "℃", "required": true, "default": [18.0, 21.0, 24.0, 27.0, 30.0, 33.0, 36.0, 39.0, 42.0, 45.0]},
        {"key": "tb_dp", "label": "升温 压强差 Δp", "type": "array", "length": 10, "unit": "kPa", "required": true}
      ]
    },
    {
      "name": "表B 等容过程·降温（选填，成对填写）",
      "fields": [
        {"key": "cool_t", "label": "降温 温度 t", "type": "array", "length": 10, "unit": "℃", "required": false},
        {"key": "cool_dp", "label": "降温 压强差 Δp", "type": "array", "length": 10, "unit": "kPa", "required": false}
      ]
    }
  ]
}
