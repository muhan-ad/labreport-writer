# ═══ 复制本文件为 .env 并填入真实值（.env 不入库，多人各自维护）═══

# ── 腾讯云 COS（贡献区读写 + 数据包推送）──
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=labreport-1485394950-1250000000
COS_REGION=ap-guangzhou

# ── MinerU 文档解析（https://mineru.net → 个人中心 → API Token）──
MINERU_TOKEN=

# ── 工作流 agent（OpenAI 兼容接口；默认小米 MiMo，可换 DeepSeek 等）──
LLM_BASE_URL=https://api.xiaomimimo.com/v1
LLM_API_KEY=
LLM_MODEL=

# ── 主仓库本地克隆路径（校验 %%DATA 键 / 合入 variants.json / 打数据包的源）──
MAIN_REPO_PATH=..

# ── 审核人署名（多人区分用，也可用命令行 --reviewer 覆盖）──
REVIEWER=
